# ─── Nova'sChat Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.

# ─── Supabase Auth (required for Google + GitHub sign-in) ───────────────────
# Create a free project at https://supabase.com
# Project Settings → API → Project URL + anon/public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Groq — Primary AI text provider (SERVER-SIDE ONLY, no VITE_ prefix) ────
# Get a free key at https://console.groq.com
# Add to Vercel → Settings → Environment Variables (NOT prefixed with VITE_)
GROQ_API_KEY=
# Optional: override model (default: openai/gpt-oss-120b)
# Other options: openai/gpt-oss-20b, qwen-qwen3-8-27b
# GROQ_MODEL=openai/gpt-oss-120b

# ─── fal.ai — Image generation (SERVER-SIDE ONLY, no VITE_ prefix) ──────────
# Get a free key at https://fal.ai/dashboard/keys
# Add to Vercel → Settings → Environment Variables (NOT prefixed with VITE_)
FAL_KEY=
# Optional: override model (default: fal-ai/flux/schnell)
# FAL_MODEL=fal-ai/flux/schnell

# ─── Google Gemini — Fallback text + image provider (client-side) ───────────
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Optional: override model (default: gemini-3.8-flash)
# VITE_GEMINI_MODEL=gemini-3.8-flash

# ─── OpenAI — Additional fallback (client-side) ──────────────────────────────
# Get a key at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
# VITE_OPENAI_MODEL=gpt-4o-mini

# ─── IMPORTANT ───────────────────────────────────────────────────────────────
# GROQ_API_KEY and FAL_KEY must NOT have VITE_ prefix — they stay server-side.
# VITE_* variables are baked into the browser bundle — never put secrets there.
# Provider priority: Groq (/api/chat) > Gemini > OpenAI > Demo mode
# Image priority:   fal.ai (/api/image) > Gemini image model
