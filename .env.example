# ─── Nova'sChat Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in the values you need.
# The app runs in demo mode when no API key is set.

# Google Gemini (AI Studio) — recommended, has a free tier
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.5-flash)
# Other options: gemini-2.5-flash-lite, gemini-2.5-pro, gemini-3.6-flash
# VITE_GEMINI_MODEL=gemini-2.5-flash

# OpenAI (ChatGPT) — alternative provider
# Get a key at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
# Optional: override the model (default: gpt-4o-mini)
# VITE_OPENAI_MODEL=gpt-4o

# ─── IMPORTANT ──────────────────────────────────────────────────────────────
# • Never commit .env to version control (it's in .gitignore).
# • VITE_ prefix is required for Vite to expose variables to the browser.
# • For production, proxy API calls through a server to avoid exposing keys.
# • If both keys are set, Gemini takes priority.
