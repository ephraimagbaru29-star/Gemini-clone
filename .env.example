# ─── Nova'sChat Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in the values you need.

# ─── Supabase Auth (required for Google + GitHub sign-in) ───────────────────
# Create a project at https://supabase.com, then find these in:
# Project Settings → API → Project URL + anon/public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Google Gemini (AI Studio) — required for real AI responses ──────────────
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.8-flash)
# VITE_GEMINI_MODEL=gemini-3.8-flash

# ─── OpenAI — alternative provider ──────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
# VITE_OPENAI_MODEL=gpt-4o-mini

# ─── IMPORTANT ───────────────────────────────────────────────────────────────
# • Never commit .env to version control (it's in .gitignore).
# • VITE_ prefix is required for Vite to expose variables to the browser.
# • If both Gemini and OpenAI keys are set, Gemini takes priority.
